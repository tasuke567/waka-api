@RELATION smartphone
@ATTRIBUTE Gender {Female,Male}
@ATTRIBUTE Age_range {18-25,26-32,33-40,41-50,60+}
@ATTRIBUTE Status {Married,Single}
@ATTRIBUTE Occupation {'Business owner','Factory worker','Government officer','Private company employee',Student}
@ATTRIBUTE Monthly_income {'More than 50001',15001-20000,20001-30000,30001-40000}
@ATTRIBUTE Daily_usage_duration {'0-1 hours','1-3 hours','3-5 hours','More than 5 hours'}
@ATTRIBUTE Smartphone_importance {'Most necessary','Not necessary',Necessary}
@ATTRIBUTE Key_factor_online_purchase {'Product feature','Product review',Price}
@ATTRIBUTE Brand_satisfaction {1,2,3,4,5}
@ATTRIBUTE Purchase_problem {'Concerns about payment security','Delivery delay','Unable to inspect product','Warranty or service concerns'}
@ATTRIBUTE Frequent_apps STRING
@ATTRIBUTE Top3_smartphone_activities STRING
@ATTRIBUTE Current_brand {'Realme 7 5G',Apple,Huawei,Infinix,Oppo,Realme,Redmi,Samsung,Vivo,Xiaomi}

